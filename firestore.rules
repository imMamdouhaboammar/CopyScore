rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'mamdouhFces1997@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function hasCurrentVerificationProof() {
      return resource.data.verificationProofVersion == 'hmac-v1';
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /handles/{handle} {
      allow read: if true;
      allow write: if false;
    }

    match /publicProfiles/{profileId} {
      allow read: if true;
      allow write: if false;
    }

    // Competition data is public only after the server stamps the current
    // HMAC-backed proof version. Legacy verified-looking rows stay unreadable.
    match /leaderboard/{entryId} {
      allow read: if hasCurrentVerificationProof();
      allow write: if false;
    }

    match /results/{resultId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.ownerUid == request.auth.uid);
      allow write: if false;
    }

    match /challenges/{challengeId} {
      allow read: if hasCurrentVerificationProof();
      allow write: if false;
    }

    match /rateLimits/{entryId} {
      allow read, write: if false;
    }

    match /aiResources/{resourceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /aiCollections/{collectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /userAIStacks/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /aiSubmissions/{submissionId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated()
        && request.resource.data.status == 'under_review'
        && (
          !request.resource.data.keys().hasAny(['submittedByUid']) ||
          request.resource.data.submittedByUid == request.auth.uid
        );
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
